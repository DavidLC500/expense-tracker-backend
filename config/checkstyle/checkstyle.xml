<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<!--
  Configuracion de Checkstyle para Expense Tracker API.

  Basada en el espiritu de Google Java Style (encaja con el formateo de Spotless +
  google-java-format), pero deliberadamente mas relajada: no exige Javadoc en cada
  metodo/clase publico ni aplica el orden de imports estricto de Google. El objetivo en
  un proyecto de portfolio que empieza es detectar problemas reales (imports sin usar,
  lineas excesivas, complejidad, nombres poco claros) sin friccion constante.
-->
<module name="Checker">
  <property name="charset" value="UTF-8" />
  <property name="severity" value="error" />
  <property name="fileExtensions" value="java" />

  <!-- Evita lineas de mas de 120 caracteres (coincide con el output de google-java-format). -->
  <module name="LineLength">
    <property name="max" value="120" />
    <property name="ignorePattern" value="^package.*|^import.*|a href|href|http://|https://" />
  </module>

  <!-- El fichero no debe terminar sin salto de linea ni contener caracteres tab. -->
  <module name="NewlineAtEndOfFile" />
  <module name="FileTabCharacter" />

  <!-- Suprime checks concretos en ficheros concretos cuando el motivo esta documentado
       (ver config/checkstyle/checkstyle-suppressions.xml). -->
  <module name="SuppressionFilter">
    <property name="file" value="config/checkstyle/checkstyle-suppressions.xml" />
    <property name="optional" value="true" />
  </module>

  <module name="TreeWalker">
    <!-- Imports -->
    <module name="RedundantImport" />
    <module name="UnusedImports" />
    <module name="AvoidStarImport" />

    <!-- Nombres -->
    <module name="PackageName" />
    <module name="TypeName" />
    <module name="MethodName" />
    <module name="MemberName" />
    <module name="ParameterName" />
    <module name="LocalVariableName" />
    <module name="ConstantName" />

    <!-- Buenas practicas / bugs frecuentes -->
    <module name="EqualsHashCode" />
    <module name="EqualsAvoidNull" />
    <module name="SimplifyBooleanExpression" />
    <module name="SimplifyBooleanReturn" />
    <module name="StringLiteralEquality" />
    <module name="OneStatementPerLine" />
    <module name="MultipleVariableDeclarations" />
    <module name="UnusedLocalVariable" />
    <module name="FallThrough" />
    <module name="MissingSwitchDefault" />
    <module name="IllegalThrows" />
    <module name="CovariantEquals" />

    <!-- Diseno: finalizacion de clases con solo constructores privados.
         (No se incluye HideUtilityClassConstructor: su heuristica de "solo miembros
         estaticos => deberia tener constructor privado" da falso positivo en clases de
         test de ArchUnit, que son package-private con solo campos "static final
         ArchRule" por convencion de la libreria, sin ser utility classes.) -->
    <module name="FinalClass" />
    <module name="InterfaceIsType" />

    <!-- Complejidad: avisa de metodos/clases que se estan volviendo dificiles de mantener -->
    <module name="CyclomaticComplexity">
      <property name="max" value="12" />
    </module>
    <module name="MethodLength">
      <property name="max" value="80" />
    </module>
    <module name="ParameterNumber">
      <property name="max" value="8" />
    </module>

    <!-- Whitespace basico, coherente con google-java-format -->
    <module name="WhitespaceAround">
      <property name="allowEmptyConstructors" value="true" />
      <property name="allowEmptyMethods" value="true" />
      <property name="allowEmptyTypes" value="true" />
      <property name="allowEmptyLoops" value="true" />
      <property name="allowEmptyLambdas" value="true" />
      <property name="allowEmptyCatches" value="true" />
    </module>
    <module name="GenericWhitespace" />
    <module name="NoWhitespaceBefore" />
    <module name="EmptyLineSeparator">
      <property name="allowNoEmptyLineBetweenFields" value="true" />
    </module>
  </module>
</module>
